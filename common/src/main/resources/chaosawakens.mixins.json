{
  "required": true,
  "minVersion": "0.8",
  "package": "io.github.chaosawakens.mixins",
  "refmap": "${mod_id}.refmap.json",
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "common.block.AttachedStemBlockMixin",
    "common.block.BushBlockMixin",
    "common.block.CropBlockMixin",
    "common.block.StemBlockMixin",
    "common.entity.LivingEntityMixin",
    "common.level.LevelMixin",
    "common.level.NoiseBasedChunkGeneratorMixin",
    "server.MinecraftServerMixin"
  ],
  "client": [
    "client.renderer.DebugRendererMixin",
    "client.renderer.GameRendererMixin"
  ],
  "server": [
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "mixinextras": {
    "minVersion": "0.5.0-rc.2"
  }
}

