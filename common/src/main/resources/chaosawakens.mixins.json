{
  "required": true,
  "minVersion": "0.8",
  "package": "io.github.chaosawakens.mixins",
  "refmap": "${mod_id}.refmap.json",
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "block.AttachedStemBlockMixin",
    "block.BushBlockMixin",
    "block.CropBlockMixin",
    "block.GrowingPlantHeadBlockMixin",
    "block.StemBlockMixin",
    "level.LevelMixin",
    "server.MinecraftServerMixin"
  ],
  "client": [
    "client.EntityRenderDispatcherMixin"
  ],
  "server": [
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "mixinextras": {
    "minVersion": "${mixinextras_version}"
  }
}

